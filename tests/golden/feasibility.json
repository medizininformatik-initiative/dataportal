{
  "description": "Feasibility golden cases on the MII test data (data-node/get-mii-testdata.sh). Each criterion names a term code and its ontology context; tests resolve it through the backend terminology API. 'expected' is the patient count. 'oracle' is the FHIR search that yields the same patients without the portal, optionally filtered by a coding in an element ('where'). 'rows' refers to the release test plan.",
  "cases": [
    {
      "id": "gender-male",
      "rows": [
        "BE-2"
      ],
      "inclusion": [
        [
          {
            "code": "263495000",
            "context": "Patient",
            "valueConcepts": [
              "male"
            ],
            "oracle": {
              "search": "Patient?gender=male"
            }
          }
        ]
      ],
      "expected": 7
    },
    {
